{
  "name": "COMEBACK",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --user -r requirements.txt",
  "postAttachCommand": "python -m comeback",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "COMEBACK demo", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
