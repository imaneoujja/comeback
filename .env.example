# Microsoft Foundry (Azure OpenAI) — v1 OpenAI-compatible endpoint of your resource.
# Format: https://<resource-name>.openai.azure.com/openai/v1/
FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
# "KEY 1" of the Foundry resource (Overview / Keys and Endpoint).
FOUNDRY_API_KEY=your-key
# Deployment name (not the model family name, if you renamed it).
FOUNDRY_MODEL=gpt-4.1-mini

# offline (cache + templates only) | live | record (live + write cache)
LLM_MODE=offline
